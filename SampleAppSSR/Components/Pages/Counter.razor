@page "/counter"
@attribute [StreamRendering]

<h3>Counter: @Count</h3>

@code {
    private int Count { get; set; } = 100;
     
    protected override async Task OnInitializedAsync()
    {
        for(int i=10; i>0; i--)
        {
            await Task.Delay(3000);
            Count--;
            StateHasChanged();
        }
    }
}
